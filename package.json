{
  "name": "trf5-pje-scraper",
  "version": "1.0.0",
  "description": "HTTP only scraper for the TRF5 PJe public records portal (JBoss Seam / JSF 1.2 / RichFaces 3.3)",
  "license": "MIT",
  "private": true,
  "type": "commonjs",
  "main": "dist/index.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "probe": "tsx src/index.ts probe",
    "classes": "tsx src/index.ts classes",
    "crawl": "tsx src/index.ts crawl",
    "retry": "tsx src/index.ts retry",
    "export": "tsx src/index.ts export",
    "test": "tsx test/run.ts"
  },
  "dependencies": {
    "axios": "^1.7.7",
    "axios-cookiejar-support": "^5.0.3",
    "cheerio": "^1.0.0",
    "domhandler": "^5.0.3",
    "iconv-lite": "^0.6.3",
    "tough-cookie": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  }
}
